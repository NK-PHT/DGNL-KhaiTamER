{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.github/**",
      "**/node_modules/**",
      "HUONG_DAN.md",
      "*.md",
      "test.html",
      "test2.html",
      "index-1.html",
      "firestore.rules",
      "js/app-1.js",
      "cong-cu-google-sheet/**",
      "cong-cu-chuyen-de/**",
      "worker/**",
      "tools/**",
      "wrangler.jsonc",
      "data/chuyen-de/**",
      "data/de-that.js",
      "data/de-mon/l*.js"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|ico|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
