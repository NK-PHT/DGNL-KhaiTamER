// =========================================================================
// FIRESTORE SECURITY RULES — web ĐGNL Online (dgnl.irismath.com)
// =========================================================================
// Dán TOÀN BỘ nội dung file này vào Firebase Console -> Firestore Database
// -> tab "Rules" -> Publish. (GitHub tự deploy web nhưng KHÔNG tự deploy
// file này — mỗi lần sửa file này phải dán lại vào Console.)
//
// - hocsinh/{email}: danh sách Gmail được phép. Mỗi học sinh chỉ "hỏi" được
//   đúng email của chính mình (có hay không) — KHÔNG ai xem được cả danh
//   sách, trừ giáo viên. Chỉ giáo viên được thêm/xoá.
// - ketqua/{id}: chỉ học sinh CÓ TRONG DANH SÁCH mới nộp bài được; mỗi em
//   chỉ đọc bài của mình; giáo viên đọc được tất cả.
// - btvn/{tuan}: thông tin bài tập tuần (tên, số câu, hạn nộp, link đề) —
//   học sinh trong danh sách đọc được, chỉ giáo viên sửa.
// - btvn_dapan/{tuan}: đáp án — học sinh CHỈ đọc được từ ngày giáo viên
//   đặt "moLoiGiai" (sau buổi sửa bài) VÀ khi đã nộp bài tuần đó.
// - btvn_bainop/{uid}_{tuan}: phiếu trả lời — mỗi em chỉ đọc phiếu của mình
//   và chỉ NỘP 1 LẦN (không sửa được). Số câu đúng (soDung) do Google Sheet
//   của giáo viên chấm và ghi vào — học sinh không tự ghi được.
// =========================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function daDangNhap() {
      return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email_verified == true;
    }
    function emailCuaToi() {
      return request.auth.token.email.lower();
    }
    function laGiaoVien() {
      return daDangNhap() && emailCuaToi() == 'thuthuy611103@gmail.com';
    }
    function duocPhep() {
      return daDangNhap()
          && (laGiaoVien()
              || exists(/databases/$(database)/documents/hocsinh/$(emailCuaToi())));
    }

    match /hocsinh/{email} {
      allow get: if daDangNhap() && emailCuaToi() == email;
      allow read: if laGiaoVien();
      allow create, update: if laGiaoVien() && email == email.lower();
      allow delete: if laGiaoVien();
    }

    function tuan(t) {
      return get(/databases/$(database)/documents/btvn/$(t)).data;
    }
    function phieuHopLe(id) {
      let d = request.resource.data;
      return duocPhep()
          && d.keys().hasOnly(['uid', 'email', 'ten', 'tuanId', 'traLoi', 'nopLuc', 'daCham'])
          && d.daCham == false
          && d.uid == request.auth.uid
          && d.email == emailCuaToi()
          && d.ten is string && d.ten.size() <= 100
          && d.tuanId is string
          && id == request.auth.uid + '_' + d.tuanId
          && exists(/databases/$(database)/documents/btvn/$(d.tuanId))
          && d.traLoi is string && d.traLoi.size() == tuan(d.tuanId).soCau
          && d.traLoi.matches('^[ABCD-]+$')
          && d.nopLuc == request.time;
    }

    match /btvn/{t} {
      allow read: if duocPhep();
      allow write: if laGiaoVien();
    }

    match /btvn_dapan/{t} {
      allow get: if laGiaoVien()
                 || (duocPhep()
                     && tuan(t).get('moLoiGiai', null) != null
                     && tuan(t).moLoiGiai < request.time
                     && exists(/databases/$(database)/documents/btvn_bainop/$(request.auth.uid + '_' + t)));
      allow list: if laGiaoVien();
      allow write: if laGiaoVien();
    }

    match /btvn_bainop/{id} {
      allow get: if laGiaoVien()
                 || (duocPhep() && id.matches(request.auth.uid + '_.+'));
      allow list: if laGiaoVien();
      allow create: if phieuHopLe(id);
      allow update, delete: if laGiaoVien();
    }

    match /ketqua/{docId} {
      allow create: if duocPhep()
                    && request.auth.uid == request.resource.data.uid;
      allow read: if laGiaoVien()
                  || (duocPhep() && request.auth.uid == resource.data.uid);
      allow update, delete: if false;
    }
  }
}
